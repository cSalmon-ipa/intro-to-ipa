{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES6",
    "useDefineForClassFields": true,
    "lib": [
      "ESNEXT",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "actions/*": [
        "./src/actions/*"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "containers/*": [
        "./src/containers/*"
      ],
      "hooks/*": [
        "./src/hooks/*"
      ],
      "i18n/*": [
        "./src/i18n/*"
      ],
      "pages/*": [
        "./src/pages/*"
      ],
      "reducers/*": [
        "./src/reducers/*"
      ],
      "style/*": [
        "./src/style/*"
      ],
      "tests/*": [
        "./src/tests/*"
      ],
      "utils/*": [
        "./src/utils/*"
      ],
      "validators/*": [
        "./src/validators/*"
      ]
    },
    /* Linting */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*",
  ]
}
