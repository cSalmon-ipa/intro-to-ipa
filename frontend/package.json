{
  "name": "hello-ipa-frontend",
  "private": true,
  "description": "Introduction project to get people familiar with IPA code style",
  "version": "0.3.23",
  "type": "module",
  "scripts": {
    "ci": "pnpm install --frozen-lockfile --ignore-scripts",
    "start": "vite --open",
    "types": "tsc --project ./tsconfig.app.json --noEmit",
    "gotypes": "tsgo --project ./tsconfig.app.json --noEmit",
    "gotypesaware": "oxlint --type-aware --type-check",
    "eslint": "eslint --quiet .",
    "fix": "eslint . --fix",
    "oxlint": "oxlint --quiet -c=./.oxlintrc.json --tsconfig=./tsconfig.app.json",
    "prettier": "prettier --check .",
    "format": "prettier --write .",
    "oxfmtcheck": "oxfmt --check",
    "oxfmt": "oxfmt",
    "oxcheck": "oxlint --quiet -c=./.oxlintrc.json --tsconfig=./tsconfig.app.json && oxfmt --check && oxlint --type-aware --type-check && eslint --quiet .",
    "check": "oxlint --quiet -c=./.oxlintrc.json --tsconfig=./tsconfig.app.json && prettier --check . && tsc --project ./tsconfig.app.json --noEmit && eslint --quiet .",
    "lint": "oxlint -c=./.oxlintrc.json --tsconfig=./tsconfig.app.json && prettier --check . && tsc --project ./tsconfig.app.json --noEmit && eslint .",
    "preview": "vite preview",
    "build": "lingui extract-template && lingui compile --typescript && vite build",
    "buildUat": "lingui extract-template && lingui compile --typescript && vite build --base=/ --mode=UAT",
    "test": "vitest",
    "test-app": "vitest --silent --project=app",
    "test-app-ci": "vitest --run --silent  --project=app",
    "extract": "lingui extract",
    "compile": "lingui compile --typescript"
  },
  "dependencies": {
    "@date-io/date-fns": "^2.11.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@lingui/core": "5.6.0",
    "@lingui/react": "^5.3.3",
    "@tanstack/react-form": "^1.19.2",
    "@tanstack/react-query": "^5.35.1",
    "@tanstack/react-table":"^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.28.0",
    "lucide-react": "^0.554.0",
    "posthog-js": "^1.331.1",
    "react": "^18.2.0",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.5",
    "react-intersection-observer": "^9.16.0",
    "react-router": "^7.12.0",
    "react-to-print": "^2.14.7",
    "read-excel-file": "^5.8.6",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@tanstack/eslint-plugin-query": "^5.51.1",
    "@tanstack/react-query-devtools": "^5.62.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@typescript/native-preview": "7.0.0-dev.20260116.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-oxlint": "^1.23.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.10",
    "jiti": "^2.4.2",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.14.0",
    "oxlint-tsgolint": "^0.11.1",
    "postcss": "^8.4.38",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.7.1", 
    "tailwindcss": "^3.4.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  },
  "prettier": {
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "jsxSingleQuote": true,
    "bracketSameLine": false,
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": true,
    "tailwindConfig": "./tailwind.config.js",
    "tailwindFunctions": [
      "cva"
    ],
    "importOrder": [
      "",
      "<BUILTIN_MODULES>",
      "",
      "^@[^/]+/.*",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^(actions|components|containers|hooks|pages|reducers|style|utils|validators)(/.*)?$",
      "^@/.*",
      "",
      "^[.]"
    ]
  }
}
